# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the site (used for link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show demo invitation links on the home page in production builds (preview deploys only)
NEXT_PUBLIC_SHOW_DEMO_LINKS=0

# --- Phase 2: Supabase (leave empty to use the in-memory demo store) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to read/write a guest's own RSVP after checking their slug.
SUPABASE_SERVICE_ROLE_KEY=
