# Copy to .env.local for local dev. Never commit .env.local.
# On Cloudflare these are set in Workers → wedding-manager → Settings → Variables and Secrets
# (runtime values; no NEXT_PUBLIC_ prefix needed).

SITE_URL=http://localhost:3000

# Supabase (leave empty to use the in-memory demo store)
SUPABASE_URL=
# Server only — mark as Secret on Cloudflare.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
