{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-manager",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // keep variables/secrets set in the Cloudflare dashboard across git deploys
  "keep_vars": true,
  // non-secret runtime settings (the Supabase service key is a dashboard Secret)
  "vars": {
    "SUPABASE_URL": "https://uzmzuwcpykegddokhybd.supabase.co",
    "SITE_URL": "https://wedding-manager.amanpd0.workers.dev",
    "SHOW_DEMO_LINKS": "1"
  },
  // per-IP limits: invite opens / calendar 60 per minute, RSVP saves 10 per minute
  "ratelimits": [
    { "name": "INVITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RSVP_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": true
}
